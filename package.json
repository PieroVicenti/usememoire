{
  "name": "usememoire",
  "version": "0.1.0",
  "description": "Persistent local memory for LLMs via MCP",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "usememoire": "dist/server.js"
  },
  "scripts": {
    "build:ui": "cd ui && npm run build",
    "build:server": "tsc",
    "build": "npm run build:ui && npm run build:server",
    "dev:ui": "cd ui && npm run dev",
    "dev": "tsx src/server.ts"
  },
  "keywords": ["mcp", "memory", "llm", "claude", "ai"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "openai": "^7.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
